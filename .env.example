# Local dev: leave empty to use Vite proxy → http://localhost:5000/api
# Or set explicitly: VITE_API_URL=http://localhost:5000
VITE_API_URL=

# Production (used for `npm run build` unless overridden in .env.production):
# VITE_API_URL=https://your-app.up.railway.app

VITE_SITE_URL=https://your-app.up.railway.app
VITE_CONTACT_EMAIL=outfind.styler@gmail.com
