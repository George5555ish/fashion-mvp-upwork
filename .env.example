# Local dev: leave empty to use Vite proxy → http://localhost:5000/api
# Or set explicitly: VITE_API_URL=http://localhost:5000
VITE_API_URL=

# Production build uses .env.production (Railway backend URL).
# If you deploy the frontend separately from the API, this MUST be set:
# VITE_API_URL=https://fashion-mvp-upwork-server-production.up.railway.app

VITE_SITE_URL=https://your-app.up.railway.app
VITE_CONTACT_EMAIL=outfind.styler@gmail.com
